# Qlo Base Sepolia Deployment & Live Verification Configuration
# Copy this file to .env (gitignored) and fill in your funded Base Sepolia deployer key.
# NEVER commit .env or expose DEPLOYER_PRIVATE_KEY.

# Required: 32-byte hex private key for a wallet funded with ~0.05 Base Sepolia ETH (Chain ID 84532)
DEPLOYER_PRIVATE_KEY=

# Optional: Base Sepolia JSON-RPC endpoint (defaults to https://sepolia.base.org)
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# Optional: Custom accredited hospital address inserted into the Poseidon hospitalRoot.
# scripts/deploy-base-sepolia.ps1 defaults this to your deployer wallet address for easy 1-wallet demos.
EXTRA_HOSPITAL_ADDRESS=

# Optional: 10-digit NPI matching CMS-1500 presets & OCR sample bill (defaults to 1234567890)
EXTRA_HOSPITAL_NPI=1234567890

# Optional: Initial Insurer ETH escrow seeded in ClaimsVault during deployment (0.02 ETH = 20000000000000000 wei)
INITIAL_ESCROW_WEI=20000000000000000

# Optional: Free Etherscan V2 API key for Basescan contract source verification (Sourcify works with 0 keys)
ETHERSCAN_API_KEY=
