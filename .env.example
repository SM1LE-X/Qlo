# Qlo Ethereum Sepolia Deployment & Live Verification Configuration
# Copy this file to .env (gitignored) and fill in your funded Ethereum Sepolia deployer key.
# NEVER commit .env or expose DEPLOYER_PRIVATE_KEY.

# Required: 32-byte hex private key for a wallet funded with ~0.05 Ethereum Sepolia ETH (Chain ID 11155111)
DEPLOYER_PRIVATE_KEY=

# Optional: Ethereum Sepolia JSON-RPC endpoint (defaults to https://ethereum-sepolia-rpc.publicnode.com)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Optional: Public RPC override bundled into apps/web wagmi client
NEXT_PUBLIC_SEPOLIA_RPC_URL=

# Optional: Extra accredited teammate/judge hospital wallet address(es), comma-separated.
# scripts/deploy-sepolia.ps1 ALWAYS includes your deployer wallet alongside any extra addresses
# so both your primary wallet and teammate/judge hospital wallets pass Poseidon hospitalRoot.
EXTRA_HOSPITAL_ADDRESS=

# Optional: 10-digit NPI(s) (comma-separated, defaults to 1234567890 matching CMS-1500 presets)
EXTRA_HOSPITAL_NPI=1234567890

# Optional: Initial Insurer ETH escrow seeded in ClaimsVault during deployment (0.02 ETH = 20000000000000000 wei)
INITIAL_ESCROW_WEI=20000000000000000

# Optional: Free Etherscan V2 API key for Sepolia Etherscan contract source verification (Sourcify works with 0 keys)
ETHERSCAN_API_KEY=

# Slack-Native Clearinghouse (set directly in Vercel Environment Variables; never commit real values)
# Bot User OAuth Token (xoxb-...) from Slack App -> OAuth & Permissions
SLACK_BOT_TOKEN=
# Signing secret from Slack App -> Basic Information (HMAC-SHA256 + 5-min replay window)
SLACK_SIGNING_SECRET=
# Sepolia relayer private key (accredited hospital + seeded insurer wallet) for live 1-click Slack settlement
SEPOLIA_RELAYER_PRIVATE_KEY=
# Optional: explicit Slack channel IDs (if omitted, Qlo auto-discovers #patient-vault, #hospital-claims, #insurer-escrow or falls back to DM)
SLACK_CHANNEL_PATIENT=
SLACK_CHANNEL_HOSPITAL=
SLACK_CHANNEL_INSURER=
# Optional: direct link for the "Open in Slack" button on https://qlo-three.vercel.app
NEXT_PUBLIC_SLACK_OPEN_URL=
# Optional incoming webhooks (legacy fallback)
SLACK_WEBHOOK_URL_PATIENT=
SLACK_WEBHOOK_URL_HOSPITAL=
SLACK_WEBHOOK_URL_INSURER=
# Directory where the relay persists state (must be writable)
QLO_DATA_DIR=
